# Use the Lakes League project, not the Shooktoberfest project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Explicit fictional demo. Never enable this for the production league.
VITE_DEMO_MODE=false

# Enable only after configuring Google OAuth in this Supabase project.
VITE_GOOGLE_AUTH_ENABLED=false

# Vercel/server only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://www.lakesleague.com
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
STRIPE_LIVE_APPROVED=false
LEAGUE_PAYMENTS_ENABLED=false
# The reviewed branch preview uses its own exact APP_ORIGIN and webhook secret.
# Enable test Checkout only after provider and database setup; test payments do not settle real dues.

# Application/approval notifications (separate from Supabase Auth SMTP). Server only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
