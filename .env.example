# Client (Vite) — exposed to the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel functions / /api). Never prefix with VITE_ or they will
# leak into the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to authenticate the Vercel Cron call to /api/sync-handicaps.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional GHIN public-lookup overrides. Leave unset to use defaults baked into
# api/_lib/ghin.js. Only set these if GHIN rotates the public widget credentials.
# GHIN_PUBLIC_USER=
# GHIN_PUBLIC_PASS=
# GHIN_PUBLIC_TOKEN=
